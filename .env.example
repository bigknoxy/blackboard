# ==============================================================================
# Multi-Agent Blackboard System - Environment Configuration (32GB Homelab Tuned)
# ==============================================================================

# --- PostgreSQL + pgvector Configuration ---
POSTGRES_USER=blackboard
POSTGRES_PASSWORD=blackboard_secret
POSTGRES_DB=blackboard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://blackboard:blackboard_secret@postgres:5432/blackboard_db
SYNC_DATABASE_URL=postgresql+psycopg://blackboard:blackboard_secret@postgres:5432/blackboard_db

# Connection Pool Limits (Memory-friendly for multi-worker homelab deployment)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Redis Streams & Lease Plane ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_TASK_STREAM=stream:tasks
REDIS_CONSUMER_GROUP=agent_worker_pool
REDIS_EVENTS_CHANNEL=channel:blackboard:events
TASK_LEASE_TTL_SECONDS=60

# --- Local / LAN Inference & Embeddings Cluster ---
# Primary Ollama Host: 192.168.1.150 (qwen2.5-coder:7b, qwen3:8b, deepseek-coder-v2:16b-lite-instruct-q2_K)
LOCAL_OLLAMA_URL=http://192.168.1.150:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Additional LAN llama.cpp / OpenAI-Compatible Nodes:
# LAPTOP (192.168.1.149): 8080=mistral-24b | 8081=qwen3-4b | 8090=lfm3-1.7b
LAN_LAPTOP_MISTRAL_URL=http://192.168.1.149:8080/v1
LAN_LAPTOP_QWEN_URL=http://192.168.1.149:8081/v1
LAN_LAPTOP_LFM_URL=http://192.168.1.149:8090/v1

# CT118 (192.168.1.180): 8080=groot-19b | 8081=qwen3-4b | 8090=lfm3-1.7b
LAN_CT118_GROOT_URL=http://192.168.1.180:8080/v1
LAN_CT118_QWEN_URL=http://192.168.1.180:8081/v1
LAN_CT118_LFM_URL=http://192.168.1.180:8090/v1

# Optional Cloud / NIM Fallbacks
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
OPENAI_BASE_URL=http://192.168.1.180:8080/v1
OPENAI_API_KEY=

# --- Control Plane & MCP Gateway ---
CONTROL_PLANE_URL=http://control-plane:8000
MCP_SERVERS_CONFIG={"filesystem":{"transport":"stdio","command":"python","args":["-m","mcp_filesystem_stub"]}}
BLACKBOARD_PRUNE_THRESHOLD=15
BLACKBOARD_SUMMARY_KEEP_RECENT=5

# --- Web Cockpit (Vite) ---
VITE_API_BASE_URL=
VITE_WS_URL=
